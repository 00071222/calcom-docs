*.tsbuildinfo

# Optional caches
.npm
.eslintcache
.stylelintcache
.microflow

# Serverless Webpack directories
.webpack/

# dotenv environment variable files (containing secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

